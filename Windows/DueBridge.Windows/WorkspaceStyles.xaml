<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WorkspaceBackground" Color="#F3F5FA" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Divider" Color="#DCE2ED" />
    <SolidColorBrush x:Key="InputBorder" Color="#8995AC" />
    <SolidColorBrush x:Key="Ink" Color="#17203A" />
    <SolidColorBrush x:Key="MutedInk" Color="#4D5B75" />
    <SolidColorBrush x:Key="QuietSurface" Color="#F1F3FA" />
    <SolidColorBrush x:Key="Accent" Color="#4942A8" />
    <SolidColorBrush x:Key="AccentHover" Color="#3D3694" />
    <SolidColorBrush x:Key="AccentPressed" Color="#302A7B" />
    <SolidColorBrush x:Key="AccentTint" Color="#ECEBFA" />
    <SolidColorBrush x:Key="BannerInk" Color="#F5F4FE" />
    <SolidColorBrush x:Key="BannerMuted" Color="#D2D4EF" />
    <SolidColorBrush x:Key="Mint" Color="#88F2D0" />
    <SolidColorBrush x:Key="BannerInset" Color="#34306E" />
    <LinearGradientBrush x:Key="Banner" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B224D" Offset="0" />
        <GradientStop Color="#332966" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="WorkspaceFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="7" RadiusY="7" StrokeThickness="2"
                               Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" StrokeDashArray="2 1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SectionNumber" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="InlineStatus" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource QuietSurface}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentTint}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Divider}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource QuietSurface}" />
                <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}" />
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}" />
    </Style>
    <Style x:Key="Input" TargetType="Control">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Input}" />
    <Style TargetType="PasswordBox" BasedOn="{StaticResource Input}" />
    <Style TargetType="Label">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource QuietSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="39" />
    </Style>
    <Style x:Key="TableText" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="TaskCell" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CountdownCell" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
