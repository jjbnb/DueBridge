<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DueBridge</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <EmbeddedResource Include="../../Resources/DueBridge-1024.png" LogicalName="DueBridge.Brand.png" />
    <ProjectReference Include="../DueBridge.Core/DueBridge.Core.csproj" />
    <ProjectReference Include="../DueBridge.Outlook/DueBridge.Outlook.csproj" />
    <ProjectReference Include="../DueBridge.School/DueBridge.School.csproj" />
    <AssemblyMetadata Include="DueBridgeOutlookClientId" Value="$(DueBridgeOutlookClientId)" />
  </ItemGroup>
</Project>
