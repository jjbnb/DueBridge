<Window x:Class="DueBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="归期 DueBridge" Height="780" Width="1080" MinHeight="580" MinWidth="800"
        Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" Language="zh-CN">
    <Window.Resources>
        <ResourceDictionary Source="WorkspaceStyles.xaml" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Banner}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12"
                TextElement.Foreground="{DynamicResource BannerInk}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5*" MaxWidth="360" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" VerticalAlignment="Center" CornerRadius="11"
                            Background="{DynamicResource BannerInset}" Margin="0,0,12,0">
                        <Viewbox Width="32" Height="32" Stretch="Uniform">
                            <Canvas Width="32" Height="32">
                                <Path Data="M 2,13 H 7 C 10,13 10,4 19,4 A 12,12 0 0 1 19,28 C 10,28 10,19 7,19 H 2"
                                      Stroke="{DynamicResource BannerInk}" StrokeThickness="2.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M 15,16 L 18,19 L 24,13" Stroke="{DynamicResource Mint}" StrokeThickness="2.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="25" FontWeight="SemiBold">
                            <Run Text="归期" /><Run Text="  DueBridge" FontSize="16" Foreground="{DynamicResource BannerMuted}" />
                        </TextBlock>
                        <TextBlock Text="把课程截止时间汇入桌面，也可同步至个人 Outlook 日历。"
                                   Foreground="{DynamicResource BannerMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource BannerInset}" Padding="12,8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="课程提醒" Foreground="{DynamicResource Mint}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBlock x:Name="EarliestDeadline" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          AutomationProperties.Name="课程来源与 Outlook 设置">
                <StackPanel Margin="0,0,3,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Style="{StaticResource SectionNumber}">
                                    <TextBlock Text="01" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="课程来源" Style="{StaticResource SectionHeading}" />
                            </StackPanel>
                            <Label Content="来源" Target="{Binding ElementName=SourcePicker}" Margin="0,0,0,4" />
                            <ComboBox x:Name="SourcePicker" SelectionChanged="OnSourceChanged" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button x:Name="BbLoginButton" Content="打开 BB 登录网页" Click="OnOpenBlackboard" />
                                <Button x:Name="SchoolLoginButton" Content="登录学校平台" Click="OnSchoolLogin" />
                                <Button x:Name="PreviewButton" Content="读取预览" Click="OnPreview" Style="{StaticResource PrimaryButton}" />
                            </WrapPanel>
                            <TextBlock x:Name="SchoolNetworkHint" Style="{StaticResource Caption}" Margin="0,2,0,2"
                                       Text="请先连接浙大校园网，再登录或读取课程。" />
                            <StackPanel x:Name="BbInput" Margin="0,4,0,0">
                                <Label Content="BB 私人 HTTPS 日历订阅链接" Target="{Binding ElementName=BlackboardAddress}" Margin="0,0,0,4" />
                                <PasswordBox x:Name="BlackboardAddress" Margin="0,0,0,5" />
                                <TextBlock Text="在 BB 网页的日历中复制 Get External Calendar Link，再粘贴到这里。已保存链接时可直接读取。"
                                           Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Border Style="{StaticResource InlineStatus}" Margin="0,8,0,0">
                                <TextBlock x:Name="SourceStatus" Style="{StaticResource Caption}" />
                            </Border>
                            <CheckBox x:Name="DesktopAutoReadBox" Content="每天自动更新此来源的桌面任务"
                                      Click="OnToggleDesktopRead" Margin="0,10,0,3" />
                            <TextBlock Text="读取预览后即可显示在桌面；无需连接 Outlook。" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,10">
                        <StackPanel>
                            <TextBlock Text="Microsoft To Do" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                            <TextBlock x:Name="TodoStatus" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button x:Name="TodoLoginButton" Content="授权 To Do" Click="OnTodoLogin" />
                                <Button x:Name="TodoSwitchButton" Content="切换 To Do 账号" Click="OnTodoSwitch" />
                                <Button x:Name="TodoListButton" Content="创建 / 恢复归期列表" Click="OnTodoList" />
                                <Button x:Name="TodoConsentButton" Content="启用此来源到 To Do" Click="OnTodoConsent" />
                                <Button Content="打开 To Do 网页" Click="OnOpenTodo" />
                                <Button x:Name="TodoPendingButton" Content="处理待确认创建" Click="OnTodoPending" />
                            </WrapPanel>
                            <TextBlock Text="独立授权待办权限，不要求 Outlook 日历。已完成状态、个人备注及用户提醒保留。" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource SectionNumber}">
                                    <TextBlock Text="02" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Outlook 日历与同步" Style="{StaticResource SectionHeading}" />
                            </StackPanel>
                            <Border Style="{StaticResource InlineStatus}" Margin="0,0,0,8">
                                <TextBlock x:Name="TargetStatus" Style="{StaticResource Caption}" />
                            </Border>
                            <WrapPanel>
                                <Button x:Name="OutlookLoginButton" Content="授权个人 Outlook" Click="OnOutlookLogin" />
                                <Button x:Name="SwitchAccountButton" Content="更换 Outlook 账号" Click="OnSwitchOutlook" />
                                <Button x:Name="CalendarButton" Content="设置 DueBridge 日历" Click="OnCreateCalendar" />
                            </WrapPanel>
                            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,2,0,8" />
                            <WrapPanel>
                                <Button x:Name="SourceConsentButton" Content="启用此来源同步" Click="OnChangeSourceConsent" />
                                <Button x:Name="SyncButton" Content="立即更新" Click="OnSyncNow" Style="{StaticResource PrimaryButton}" />
                                <Button x:Name="PauseButton" Content="暂停全部同步" Click="OnTogglePause" />
                            </WrapPanel>
                            <CheckBox x:Name="StartAtLoginBox" Content="登录 Windows 时启动" Click="OnStartAtLogin" Margin="0,4,0,6" />
                            <TextBlock Text="以北京时间零点为每日更新基准，启动、唤醒和网络恢复后补查。关闭主窗口会退出；使用桌面卡片时请最小化主窗口。"
                                       Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="PreviewCard" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="14,12">
                        <Button x:Name="DesktopCardButton" DockPanel.Dock="Right" Content="桌面卡片"
                                Click="OnShowDesktopCard" Margin="8,0,0,0" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource InlineStatus}" Padding="8,4" Margin="8,0,0,0">
                            <TextBlock Text="北京时间" Style="{StaticResource Caption}" />
                        </Border>
                        <TextBlock Text="截止时间预览" Style="{StaticResource SectionHeading}" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="PreviewGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                  SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="False"
                                  SelectionChanged="OnPreviewSelection" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  AutomationProperties.Name="截止时间预览（北京时间）"
                                  FontSize="12" Foreground="{DynamicResource Ink}" Background="{DynamicResource Surface}"
                                  RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource WorkspaceBackground}"
                                  HorizontalGridLinesBrush="{DynamicResource Divider}" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="任务" Binding="{Binding Title}" Width="2*" MinWidth="100" ElementStyle="{StaticResource TaskCell}" />
                                <DataGridTextColumn Header="课程" Binding="{Binding Course}" Width="*" MinWidth="74" ElementStyle="{StaticResource TableText}" />
                                <DataGridTextColumn Header="截止" Binding="{Binding Deadline}" Width="120" ElementStyle="{StaticResource TableText}" />
                                <DataGridTextColumn Header="倒计时" Binding="{Binding Countdown}" Width="114" ElementStyle="{StaticResource CountdownCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,36,14,0" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=PreviewGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource SectionNumber}" Width="40" Height="40" CornerRadius="10"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Path Data="M 2,5 H 18 V 18 H 2 Z M 2,9 H 18 M 6,2 V 7 M 14,2 V 7 M 6,13 H 9"
                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="暂无截止时间" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />
                            <TextBlock Text="选择课程来源并读取预览，任务会显示在这里。" Style="{StaticResource Caption}"
                                       TextAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Visibility="{Binding Visibility, ElementName=CourseEditor}"
                            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}" Padding="14,8,8,2">
                        <WrapPanel x:Name="CourseEditor">
                            <Label Content="BB 本地课程名称" Target="{Binding ElementName=CourseInput}" Margin="0,0,8,6" VerticalAlignment="Center" />
                            <TextBox x:Name="CourseInput" Width="126" MaxLength="100" Margin="0,0,6,6" />
                            <Button x:Name="SaveCourseButton" Content="保存名称" Click="OnSaveCourse" />
                            <Button x:Name="ClearCourseButton" Content="清除名称" Click="OnClearCourse" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,7" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="操作状态" FontWeight="SemiBold" Margin="0,0,10,0" />
                <ScrollViewer MaxHeight="58" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <TextBlock x:Name="Status" Text="就绪" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}"
                               AutomationProperties.LiveSetting="Polite" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
