<Window x:Class="DueBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="归期 DueBridge" Height="790" Width="920" MinHeight="660" MinWidth="740"
        FontSize="14" WindowStartupLocation="CenterScreen" Language="zh-CN">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,16,6" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="归期" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,3,0,12" Text="预览课程截止时间，并将选定的来源同步到个人 Outlook 日历。" />
            <TextBlock x:Name="EarliestDeadline" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="1　预览课程截止时间" Margin="0,0,0,9" Padding="9">
            <StackPanel>
                <WrapPanel>
                    <Label Content="来源" Target="{Binding ElementName=SourcePicker}" Padding="0,4,6,4" />
                    <ComboBox x:Name="SourcePicker" Width="165" Margin="0,0,12,6" SelectionChanged="OnSourceChanged" />
                    <Button x:Name="BbLoginButton" Content="打开 BB 登录网页" Click="OnOpenBlackboard" />
                    <Button x:Name="SchoolLoginButton" Content="登录学校平台" Click="OnSchoolLogin" />
                    <Button x:Name="PreviewButton" Content="读取预览" Click="OnPreview" />
                </WrapPanel>
                <TextBlock x:Name="SchoolNetworkHint" Margin="0,0,0,5" TextWrapping="Wrap"
                           Text="请先连接浙大校园网，再登录或读取课程。" />
                <StackPanel x:Name="BbInput">
                    <Label Content="BB 私人 HTTPS 日历订阅链接" Target="{Binding ElementName=BlackboardAddress}" Padding="0,0,0,4" />
                    <PasswordBox x:Name="BlackboardAddress" Padding="4" Margin="0,0,0,5" />
                    <TextBlock Text="在 BB 网页的日历中复制 Get External Calendar Link，再粘贴到这里。已保存链接时可直接读取。"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="SourceStatus" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="2　设置 Outlook 日历与同步" Margin="0,0,0,9" Padding="9">
            <StackPanel>
                <TextBlock x:Name="TargetStatus" TextWrapping="Wrap" Margin="0,0,0,7" />
                <WrapPanel>
                    <Button x:Name="OutlookLoginButton" Content="授权个人 Outlook" Click="OnOutlookLogin" />
                    <Button x:Name="SwitchAccountButton" Content="更换 Outlook 账号" Click="OnSwitchOutlook" />
                    <Button x:Name="CalendarButton" Content="设置 DueBridge 日历" Click="OnCreateCalendar" />
                </WrapPanel>
                <WrapPanel>
                    <Button x:Name="SourceConsentButton" Content="启用此来源同步" Click="OnChangeSourceConsent" />
                    <Button x:Name="SyncButton" Content="立即同步" Click="OnSyncNow" />
                    <Button x:Name="PauseButton" Content="暂停全部同步" Click="OnTogglePause" />
                    <CheckBox x:Name="StartAtLoginBox" Content="登录 Windows 时启动" Click="OnStartAtLogin" />
                </WrapPanel>
                <TextBlock Text="自动同步按北京时间每日执行，唤醒时检查是否需要补同步。关闭窗口会退出。" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="截止时间预览（北京时间）" FontWeight="SemiBold" Margin="0,0,0,5" />
            <DataGrid x:Name="PreviewGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                      SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="False"
                      SelectionChanged="OnPreviewSelection" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="任务" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="课程" Binding="{Binding Course}" Width="145" />
                    <DataGridTextColumn Header="截止" Binding="{Binding Deadline}" Width="150" />
                    <DataGridTextColumn Header="倒计时" Binding="{Binding Countdown}" Width="135" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel x:Name="CourseEditor" Grid.Row="2" Margin="0,7,0,0">
                <Label Content="BB 本地课程名称" Target="{Binding ElementName=CourseInput}" Padding="0,5,8,0" />
                <TextBox x:Name="CourseInput" Width="160" MaxLength="100" Padding="4" Margin="0,0,8,6" />
                <Button x:Name="SaveCourseButton" Content="保存名称" Click="OnSaveCourse" />
                <Button x:Name="ClearCourseButton" Content="清除名称" Click="OnClearCourse" />
            </WrapPanel>
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="4" TextWrapping="Wrap" Margin="0,8,0,0"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
